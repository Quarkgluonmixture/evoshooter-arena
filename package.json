{
  "name": "evoshooter-arena",
  "private": true,
  "version": "0.1.0",
  "description": "Self-evolving 3D red-vs-blue tactical shooter: deterministic simulation, neuroevolution with adversarial co-evolution, and a Three.js viewer that lets you watch tactics emerge.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "train": "node scripts/train.ts",
    "bench": "node scripts/bench.ts",
    "leaks": "node scripts/leaks.ts",
    "crossplay": "node scripts/crossplay.ts",
    "inherit": "node scripts/inherit.ts",
    "yardstick": "node scripts/yardstick.ts",
    "recprobe": "node scripts/recprobe.ts",
    "mapprobe": "node scripts/mapprobe.ts",
    "c1exit": "node scripts/c1exit.ts",
    "memdemand": "node scripts/memdemand.ts",
    "radio": "node scripts/radio.ts"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/three": "^0.185.0",
    "typescript": "^5.9.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
